{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "backend/**/*.js", 
      "use": "@vercel/node",
      "config": { "includeFiles": ["supabaseClient.js"] } 
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}